{
  "expo": {
    "name": "Circuvent HR",
    "slug": "circuvent-hrms",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "circuvent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#783FF5",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F4F7",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#0B0B10"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.circuvent.hrms",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Circuvent HR without typing your password.",
        "NSLocationWhenInUseUsageDescription": "Circuvent HR checks you are at your work location when you clock in. Your location is only read at the moment you tap clock in or clock out, and is never tracked in the background.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.circuvent.hrms",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#783FF5"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "allowBackup": false
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#783FF5"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Circuvent HR checks you are at your work location when you clock in."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://hrms.circuvent.com"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
