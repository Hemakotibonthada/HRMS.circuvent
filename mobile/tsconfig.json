{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../src/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/lib/mobile/**/*.ts",
    "../src/lib/color/**/*.ts",
    "../src/lib/money/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/lib/mobile/**/*.test.ts",
    "../src/lib/color/**/*.test.ts",
    "../src/lib/money/**/*.test.ts"
  ]
}
