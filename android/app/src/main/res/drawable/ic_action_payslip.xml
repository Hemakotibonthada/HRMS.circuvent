<?xml version="1.0" encoding="utf-8"?>
<!--
  Payslip.

  A sheet of paper carrying a rupee mark. The rupee is what makes this a payslip
  rather than any other document in the app, so it is drawn large and the text
  lines are kept short and few — at 20dp more lines would turn into a grey smear.

  The rupee glyph is built from strokes rather than set as text, because vector
  drawables cannot render text and a traced glyph would be tied to one typeface.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Page with a folded corner -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M5,2 h9.2 L20,7.8 V22 H5 Z M6.6,3.6 v16.8 h11.8 V9.2 h-4.6 V3.6 Z M15.4,4.3 L17.9,7.6 h-2.5 Z" />

    <!-- Rupee: two horizontal bars, the descending stroke, and the leg -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M8.4,11 h7.2 v1.4 h-7.2 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M8.4,13.5 h7.2 v1.4 h-7.2 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M9,16 h3.6 a2.6,2.6 0 0 0 0,-5.2 v1.4 a1.2,1.2 0 0 1 0,2.4 h-3.6 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.4,15.6 L15.4,19.6 L14.4,20.8 L9.4,16.8 Z" />
</vector>
