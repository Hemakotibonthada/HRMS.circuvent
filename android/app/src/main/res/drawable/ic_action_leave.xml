<?xml version="1.0" encoding="utf-8"?>
<!--
  Apply leave.

  A departing aircraft, drawn from straight segments rather than traced from an
  icon set, so there is no question about what is being redistributed. The
  ground line underneath is what makes it read as "leaving" rather than "travel"
  at 24dp — without it the shape is just an arrow.

  Alpha is first: Android reads eight hex digits as #AARRGGBB, not #RRGGBBAA.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <path
        android:fillColor="#FF000000"
        android:pathData="M2.5,13.2 L21,8.4 A1.6,1.6 0 0 0 20.2,5.3 L17.6,6 L12.4,2.6 L10.3,3.1 L13.3,7.1 L9.1,8.2 L6.9,6.6 L5.3,7 L7.2,10.1 Z" />

    <path
        android:fillColor="#FF000000"
        android:pathData="M3,19 h18 v1.8 h-18 z" />
</vector>
