rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // These rules previously described a data model the application does not
    // use. They only matched /organizations/{orgId}/employees, /subscriptions
    // and /users, while the app reads and writes TOP-LEVEL collections
    // (`employees`, `attendance`, `leaves`, `payroll`, ...) — see COLLECTIONS
    // in src/lib/firestore-service.ts. Firestore denies any path that no rule
    // matches, so deploying the old file would have made the entire product
    // fail closed in production.
    //
    // Tenancy: every business document carries an `organizationId`. Client
    // queries attach a matching equality filter via src/lib/tenant.ts, which is
    // required for the list rules below to permit a read.
    // ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerOrg() {
      return userDoc().organizationId;
    }

    function callerRole() {
      return userDoc().role;
    }

    function isPrivileged() {
      return hasProfile() && callerRole() in ['owner', 'admin', 'hr'];
    }

    function isManager() {
      return hasProfile() && callerRole() in ['owner', 'admin', 'hr', 'manager'];
    }

    // Document belongs to the caller's organization.
    function inOrg() {
      return hasProfile() && resource.data.organizationId == callerOrg();
    }

    // Incoming write is stamped with the caller's organization.
    function writingToOwnOrg() {
      return hasProfile() &&
        request.resource.data.organizationId == callerOrg();
    }

    // Employee-owned record (leave request, expense claim, timesheet, ...).
    function isSelfRecord() {
      return isSignedIn() && (
        resource.data.employeeId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ── Identity ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        (request.auth.uid == userId || isPrivileged());
      allow delete: if isPrivileged();
    }

    match /organizations/{orgId} {
      allow read: if hasProfile() && orgId == callerOrg();
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if hasProfile() && orgId == callerOrg() &&
        callerRole() in ['owner', 'admin'];
    }

    match /subscriptions/{subId} {
      allow read: if hasProfile() && subId == callerOrg();
      // Billing state is mutated server-side only.
      allow write: if false;
    }

    // ── Employee-writable records ──────────────────────────────
    // Staff may file their own requests; approvals stay with managers/HR.
    match /{col}/{docId} {
      allow read: if inOrg() &&
        col in [
          'leaves', 'leaveBalances', 'attendance', 'expenses', 'timesheets',
          'overtime', 'wfh', 'travel', 'helpdesk', 'feedback', 'grievances',
          'surveys', 'referrals', 'goals', 'enrollments', 'meetingBookings',
          'incidents', 'loans', 'kudos', 'visitors'
        ];

      allow create: if writingToOwnOrg() &&
        col in [
          'leaves', 'attendance', 'expenses', 'timesheets', 'overtime', 'wfh',
          'travel', 'helpdesk', 'feedback', 'grievances', 'referrals', 'goals',
          'enrollments', 'meetingBookings', 'incidents', 'loans', 'kudos',
          'visitors'
        ];

      allow update, delete: if inOrg() &&
        col in [
          'leaves', 'attendance', 'expenses', 'timesheets', 'overtime', 'wfh',
          'travel', 'helpdesk', 'feedback', 'grievances', 'referrals', 'goals',
          'enrollments', 'meetingBookings', 'incidents', 'loans', 'kudos',
          'visitors'
        ] &&
        (isManager() || isSelfRecord());
    }

    // ── Org-wide reference data ────────────────────────────────
    // Readable by any member of the organization, writable by HR/admin only.
    match /{col}/{docId} {
      allow read: if inOrg() &&
        col in [
          'employees', 'departments', 'teams', 'announcements', 'documents',
          'policies', 'holidays', 'training', 'assets', 'shifts', 'awards',
          'knowledgebase', 'wellness', 'badges', 'celebrations', 'events',
          'workflows', 'settings', 'notifications', 'performanceReviews',
          'recruitment', 'candidates', 'payroll'
        ];

      allow create: if writingToOwnOrg() && isPrivileged() &&
        col in [
          'employees', 'departments', 'teams', 'announcements', 'documents',
          'policies', 'holidays', 'training', 'assets', 'shifts', 'awards',
          'knowledgebase', 'wellness', 'badges', 'celebrations', 'events',
          'workflows', 'settings', 'notifications', 'performanceReviews',
          'recruitment', 'candidates', 'payroll'
        ];

      allow update, delete: if inOrg() && isPrivileged() &&
        col in [
          'employees', 'departments', 'teams', 'announcements', 'documents',
          'policies', 'holidays', 'training', 'assets', 'shifts', 'awards',
          'knowledgebase', 'wellness', 'badges', 'celebrations', 'events',
          'workflows', 'settings', 'notifications', 'performanceReviews',
          'recruitment', 'candidates', 'payroll'
        ];
    }

    // ── Audit log ──────────────────────────────────────────────
    // Append-only: entries may be created and read, never edited or removed.
    match /auditLog/{entryId} {
      allow read: if inOrg() && isPrivileged();
      allow create: if writingToOwnOrg();
      allow update, delete: if false;
    }
  }
}
