# ═══════════════════════════════════════════════════════════════
# HRMS.circuvent — Environment Variables (template)
# ───────────────────────────────────────────────────────────────
# Local dev : copy to .env.local
# Production: set these in Vercel → Project → Settings → Environment
#             Variables (Production + Preview).
# ═══════════════════════════════════════════════════════════════

# ── Neon Postgres (target data layer) ──
# One Neon project holds every Circuvent app, one schema each:
#   identity  shared users, orgs, sessions, roles, audit
#   hrms      this app
#   ats / cv365 / mail / web  the sibling apps
#
# Connect as the `hrms_app` role, NOT the Neon owner role. Row-level security
# is bypassed by the table owner, so using the owner here would silently
# disable tenant isolation (see drizzle/0001_row_level_security.sql).
DATABASE_URL=postgresql://hrms_app:<password>@<endpoint>.neon.tech/circuvent?sslmode=require

# Pooled connection ceiling for the node-postgres driver.
DATABASE_POOL_MAX=10

# ── Outbound mail ─────────────────────────────────────────────
# Required for anything the product sends: password resets, and every offer
# letter, reminder and signing link.
#
# When these are unset the product does not fail — it logs that the message was
# not sent and carries on. That is deliberate for a password reset, which must
# not disclose whether an address exists, but it means a misconfigured server
# looks exactly like a working one until somebody says they never received
# their offer. `/api/documents/[id]/send` reports `mailConfigured: false` and
# returns the signing links so they can be delivered by hand.
#
# Values are trimmed before use: a trailing newline pasted into a dashboard
# field is invisible, makes the host unresolvable, and stops SMTP_SECURE
# matching "true" — quietly disabling TLS.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
# "true" only for implicit TLS on port 465. STARTTLS on 587 is required either
# way, so this is not the setting that decides whether the connection is
# encrypted.
SMTP_SECURE=false
# Envelope sender. Defaults to SMTP_USER when unset.
EMAIL_FROM=Circuvent HRMS <no-reply@circuvent.com>

# Must match ATS.circuvent and Mail.circuvent — signs mailbox claim links.
ONBOARDING_TOKEN_SECRET=

# Mail.circuvent base URL for registration status lookups and claim links.
MAIL_APP_URL=https://mail.circuvent.com
# Shared with Mail.circuvent for server-to-server calls (mailbox eligibility + approval sync).
MAIL_SERVICE_TOKEN=

# own origin, which is right in development and wrong behind a proxy that
# terminates on a different hostname — a candidate would receive a link to an
# address they cannot reach.
NEXT_PUBLIC_APP_URL=https://hrms.circuvent.com

# ── Circuvent identity service ──
# Signs the 15-minute access JWT. Generate with: openssl rand -hex 32
# Signing refuses to run when this is unset or shorter than 32 characters,
# because a weak secret makes every token forgeable.
AUTH_JWT_SECRET=

# ── Encryption at rest ────────────────────────────────────────
# Encrypts identity.users.mfa_secret, identity.sso_connections.client_secret,
# and the Aadhaar and PAN columns on hrms.employees. AES-256-GCM.
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
#
# Encryption refuses to run when this is unset, rather than quietly storing
# plaintext. Reading is unaffected: values written before encryption existed
# pass through untouched, so turning this on does not lock out anyone already
# enrolled in MFA. Run `npm run db:encrypt-fields` to rewrite those rows.
ENCRYPTION_KEY=

# Retired keys, comma-separated, kept decrypt-only during a rotation so it does
# not have to happen at the same instant as rewriting every encrypted row.
# Leave unset outside a rotation.
# ENCRYPTION_KEY_PREVIOUS=

# Scope of the session cookies. Set to .circuvent.com in production so a single
# sign-in covers hrms., work., ats., mail. and office. Leave unset locally —
# a domain attribute stops the cookie being set at all on localhost.
# AUTH_COOKIE_DOMAIN=.circuvent.com

# Shared secret for machine-to-machine cross-app sync (/api/sync/bulk,
# /api/sync/employee). Callers send it as `X-Service-Token`. Requests are
# REJECTED when this is unset, so set it wherever cross-app sync runs.
CROSS_APP_SYNC_TOKEN=

# ── Local credentials mode (development only) ──
# `npm run dev:localcreds` signs in against the fixed accounts in
# src/lib/local-auth.ts. The password is intentionally NOT stored in source;
# set it here and login fails closed when it is missing.
# NEXT_PUBLIC_USE_LOCAL_CREDS=true
# NEXT_PUBLIC_LOCAL_DEV_PASSWORD=

# ── Ecosystem cross-app URLs ──
# Defaults live in src/lib/ecosystem.ts (production = circuvent.com subdomains).
# Only override for preview/staging deploys or running several apps locally.
NEXT_PUBLIC_WORK_URL=https://work.circuvent.com
NEXT_PUBLIC_HRMS_URL=https://hrms.circuvent.com
NEXT_PUBLIC_ATS_URL=https://ats.circuvent.com
NEXT_PUBLIC_MAIL_URL=https://mail.circuvent.com
NEXT_PUBLIC_OFFICE_URL=https://office.circuvent.com
NEXT_PUBLIC_LANDING_URL=https://circuvent.com

# ── Mobile app store links (web app) ──────────────────────────
# Both are OPTIONAL and both are absent by default, on purpose.
#
# src/lib/mobile-app.ts renders no store button at all until one of these is
# set to an https URL. A "Get it on Google Play" button pointing at a listing
# that does not exist yet 404s, and the person who taps it concludes the app
# was withdrawn — which is worse than never having advertised it.
#
# Set NEXT_PUBLIC_PLAY_STORE_URL only once the listing is live on a public
# track. An internal-testing track is not public: the link works for the
# testers on it and 404s for everybody else.
#
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.circuvent.hrms
# NEXT_PUBLIC_APP_STORE_URL=

# ── Paystub payroll sync ────────────────────────────────────────
# Employee changes are pushed to Paystub, which owns payroll. The push is
# queued in hrms.paystub_employee_sync_outbox first, so Paystub being
# unreachable delays a sync rather than failing the hire.
#
# The endpoint that receives these:
PAYSTUB_SYNC_URL=https://paystub.circuvent.com/api/sync/employees
#
# Shared secret. Must be byte-identical to CROSS_APP_SYNC_TOKEN in Paystub;
# rotate both together or every push starts returning 401.
# CROSS_APP_SYNC_TOKEN=  (already listed above)
#
# Which Paystub tenant each HRMS organisation belongs to. HRMS and Paystub
# hold separate databases with separate identity.organizations rows, so the
# ids are NOT interchangeable and there is deliberately no fallback: an
# unmapped organisation refuses to sync rather than guessing, because a
# guess would attach real people to another company's payroll.
#
# Find the Paystub values with:
#   select id from identity.organizations;                  -- orgId
#   select id, code from payroll.legal_entities;            -- entityId
# and the HRMS key with:
#   select id from identity.organizations;                  -- in HRMS's own db
#
# Shape: {"<hrms-org-id>":{"orgId":"<paystub-org-id>","entityId":"<paystub-entity-id>"}}
PAYSTUB_SYNC_TENANT_MAP=

# ── Scheduled sweep ───────────────────────────────────────────
# Authenticates GET /api/cron, which retries the deliveries that did not get
# through the first time: employee records owed to Paystub, and group
# memberships owed to auth.circuvent.com.
#
# Both outboxes record a next-attempt time on every failure. Until the cron
# existed nothing read it, so a push that failed on a network blip waited for
# somebody to edit that employee again — and for a leaver, nobody does.
#
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` when the variable
# is set (vercel.json schedules the call). If it is UNSET every request is
# refused, including Vercel's: treating "not configured" as "no auth needed"
# would publish an unauthenticated trigger that writes to two other systems.
CRON_SECRET=

# ── Attendance device / RFID sync ─────────────────────────────
# Reconciles the physical terminal register into hrms.attendance_records. The
# device control plane (api.circuvent.com) is a separate, already-deployed
# system this app only ever reads from — see src/lib/attendance/device-client.ts
# and src/lib/attendance/device-sync.ts. Swept daily from the same /api/cron
# call as the paystub/group outboxes above (Vercel Hobby allows one cron path).
#
# Base URL of the device control plane. Defaults to https://api.circuvent.com
# when unset, so this only needs setting for a staging device fleet.
# ATTENDANCE_DEVICE_URL=https://api.circuvent.com

# Service token for `Authorization: Bearer <token>` against the device API.
# Read lazily, never at import time, so a build or test run that never
# touches this integration cannot fail just because it is unset. Left unset,
# deviceConfigured() returns false and every sync call reports
# "not_configured" instead of throwing — the daily cron and the manual
# /api/attendance/device-sync route both treat that as a no-op, not a crash.
ATTENDANCE_DEVICE_TOKEN=

# Which device siteId each HRMS organisation's terminal reports under. Same
# shape and reasoning as PAYSTUB_SYNC_TENANT_MAP above: the device control
# plane's site ids are its own, not HRMS's, and there is deliberately no
# fallback to "site 1" or similar — a wrong guess would import another
# building's attendance into this company's records.
#
# Shape: {"<hrms-org-id>": <device-siteId>}
# An organisation missing from this map (and with no explicit siteId passed
# to the API) is skipped by the cron and rejected with 400 by the manual
# route, rather than silently syncing against the wrong site.
ATTENDANCE_DEVICE_SITE_MAP=
