# ═══════════════════════════════════════════════════════════════
# HRMS.circuvent — Environment Variables (template)
# ───────────────────────────────────────────────────────────────
# Local dev : copy to .env.local
# Production: set these in Vercel → Project → Settings → Environment
#             Variables (Production + Preview).
# ═══════════════════════════════════════════════════════════════

# ── Neon Postgres (target data layer) ──
# One Neon project holds every Circuvent app, one schema each:
#   identity  shared users, orgs, sessions, roles, audit
#   hrms      this app
#   ats / cv365 / mail / web  the sibling apps
#
# Connect as the `hrms_app` role, NOT the Neon owner role. Row-level security
# is bypassed by the table owner, so using the owner here would silently
# disable tenant isolation (see drizzle/0001_row_level_security.sql).
DATABASE_URL=postgresql://hrms_app:<password>@<endpoint>.neon.tech/circuvent?sslmode=require

# Pooled connection ceiling for the node-postgres driver.
DATABASE_POOL_MAX=10

# Selects the data backend during the Firestore → Neon migration.
# firestore | neon | dual   (dual writes both and reconciles nightly)
DATA_BACKEND=firestore

# ── Firebase (legacy; being retired — see docs/PLATFORM-ARCHITECTURE.md) ──
# Required while DATA_BACKEND is firestore or dual. There are no hardcoded
# fallbacks any more: a missing value throws on the server and logs loudly in
# the browser rather than silently connecting to the production project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=circuvent.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://circuvent-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=circuvent
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=circuvent.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=743562898363
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase emulators (local dev only) ──
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ── Server-side credentials (NEVER prefixed NEXT_PUBLIC_) ──
# API routes use the Firebase Admin SDK so that Firestore/Storage rules can stay
# locked to per-organization access while server code still does privileged work.
# Leave unset on Firebase App Hosting / Cloud Run, where Application Default
# Credentials are provided automatically. Set it elsewhere to the service-account
# JSON, either raw or base64-encoded.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Shared secret for machine-to-machine cross-app sync (/api/sync/bulk,
# /api/sync/employee). Callers send it as `X-Service-Token`. Requests are
# REJECTED when this is unset, so set it wherever cross-app sync runs.
CROSS_APP_SYNC_TOKEN=

# ── Local credentials mode (development only) ──
# `npm run dev:localcreds` signs in against the fixed accounts in
# src/lib/local-auth.ts. The password is intentionally NOT stored in source;
# set it here and login fails closed when it is missing.
# NEXT_PUBLIC_USE_LOCAL_CREDS=true
# NEXT_PUBLIC_LOCAL_DEV_PASSWORD=

# ── Ecosystem cross-app URLs ──
# Defaults live in src/lib/ecosystem.ts (production = circuvent.com subdomains).
# Only override for preview/staging deploys or running several apps locally.
NEXT_PUBLIC_WORK_URL=https://work.circuvent.com
NEXT_PUBLIC_HRMS_URL=https://hrms.circuvent.com
NEXT_PUBLIC_ATS_URL=https://ats.circuvent.com
NEXT_PUBLIC_MAIL_URL=https://mail.circuvent.com
NEXT_PUBLIC_OFFICE_URL=https://office.circuvent.com
NEXT_PUBLIC_LANDING_URL=https://circuvent.com
